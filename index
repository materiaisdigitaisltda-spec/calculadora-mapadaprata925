
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Calcule custos, taxas, preço de venda, margem e lucro das suas peças">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#111C2E">
  <title>Calculadora da Prata | Mapa da Prata 925</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='15' fill='%23111C2E'/%3E%3Crect x='10' y='9' width='44' height='15' rx='5' fill='%23F7F8FA'/%3E%3Ctext x='32' y='20' font-family='Arial' font-size='10' text-anchor='middle' font-weight='700' fill='%23111C2E'%3E925%3C/text%3E%3Crect x='10' y='29' width='12' height='11' rx='3' fill='%23F7F8FA'/%3E%3Crect x='26' y='29' width='12' height='11' rx='3' fill='%23159A72'/%3E%3Crect x='42' y='29' width='12' height='11' rx='3' fill='%23F7F8FA'/%3E%3Crect x='10' y='44' width='12' height='11' rx='3' fill='%23F7F8FA'/%3E%3Crect x='26' y='44' width='12' height='11' rx='3' fill='%23F7F8FA'/%3E%3Crect x='42' y='44' width='12' height='11' rx='3' fill='%23F7F8FA'/%3E%3C/svg%3E">
  <style>
    :root {
      --midnight: #111C2E;
      --graphite: #242932;
      --silver: #BCC3CC;
      --ice: #F7F8FA;
      --emerald: #159A72;
      --emerald-dark: #0E7657;
      --mint: #DDF4EC;
      --white: #FFFFFF;
      --danger: #B23A48;
      --danger-soft: #FCE8EB;
      --warning: #9A650E;
      --warning-soft: #FFF4D6;
      --muted: #667085;
      --border: #D8DDE3;
      --shadow: 0 14px 35px rgba(17, 28, 46, .08);
      --radius: 18px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-width: 320px;
      color: var(--graphite);
      background: var(--ice);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.5;
    }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    img { display: block; max-width: 100%; }
    a { color: inherit; }
    :focus-visible { outline: 3px solid rgba(21, 154, 114, .38); outline-offset: 3px; }
    [hidden] { display: none !important; }

    .skip-link {
      position: fixed; left: 12px; top: -60px; z-index: 1000;
      background: var(--white); color: var(--midnight); padding: 10px 14px; border-radius: 8px;
    }
    .skip-link:focus { top: 12px; }
    .container { width: min(1180px, calc(100% - 32px)); margin-inline: auto; }
    .site-header {
      position: sticky; top: 0; z-index: 100;
      color: var(--white); background: rgba(17, 28, 46, .97);
      border-bottom: 1px solid rgba(188, 195, 204, .2);
      backdrop-filter: blur(12px);
    }
    .header-inner { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .brand { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-width: 0; gap: 0; }
    .brand img { width: 218px; height: 48px; object-fit: contain; object-position: left center; padding: 4px 8px; border-radius: 9px; background: var(--white); }
    .brand-copy { display: block; }
    .brand-fallback { font-weight: 900; letter-spacing: .06em; }
    .brand small { display: block; color: var(--silver); font-size: .67rem; margin-top: 1px; }
    .header-actions { display: flex; align-items: center; gap: 10px; }
    .exclusive {
      display: none; padding: 6px 10px; border-radius: 999px;
      color: var(--mint); border: 1px solid rgba(221, 244, 236, .28); font-size: .76rem; font-weight: 800;
    }
    .header-button {
      display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,.25);
      background: rgba(255,255,255,.08); color: var(--white); padding: 10px 13px; border-radius: 11px; font-weight: 750;
    }
    .header-button svg { width: 18px; height: 18px; }

    .hero { position: relative; overflow: hidden; padding: 48px 0 34px; background: var(--midnight); color: var(--white); }
    .hero::before, .hero::after { content: ""; position: absolute; border-radius: 50%; filter: blur(2px); pointer-events: none; }
    .hero::before { width: 340px; height: 340px; right: -140px; top: -200px; background: rgba(21,154,114,.18); }
    .hero::after { width: 180px; height: 180px; left: -110px; bottom: -110px; border: 1px solid rgba(188,195,204,.15); }
    .hero-content { position: relative; max-width: 820px; }
    .eyebrow { margin: 0 0 12px; color: #8BE0C4; font-size: .78rem; font-weight: 850; letter-spacing: .12em; text-transform: uppercase; }
    h1 { margin: 0; max-width: 700px; font-size: clamp(2rem, 5.6vw, 3.6rem); line-height: 1.04; letter-spacing: -.045em; }
    .hero-lead { max-width: 720px; margin: 18px 0 22px; color: #D9DEE5; font-size: clamp(1rem, 2.2vw, 1.16rem); }
    .benefits { display: flex; flex-wrap: wrap; gap: 9px; padding: 0; margin: 0 0 22px; list-style: none; }
    .benefits li { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; border: 1px solid rgba(188,195,204,.25); border-radius: 999px; color: #EBEEF2; font-size: .82rem; }
    .benefits svg { width: 15px; color: #62D2AE; }
    .hero-note { display: flex; align-items: flex-start; gap: 9px; max-width: 680px; margin: 0; color: var(--silver); font-size: .87rem; }
    .hero-note svg { flex: 0 0 18px; margin-top: 2px; color: #62D2AE; }

    main { padding: 30px 0 56px; }
    .mode-tabs {
      display: grid; grid-template-columns: 1fr 1fr; gap: 6px; max-width: 720px; padding: 6px; margin: 0 auto 24px;
      background: #E7EBEF; border: 1px solid var(--border); border-radius: 15px;
    }
    .tab-button { border: 0; border-radius: 11px; padding: 12px 10px; background: transparent; color: var(--muted); font-weight: 800; }
    .tab-button[aria-selected="true"] { color: var(--midnight); background: var(--white); box-shadow: 0 4px 14px rgba(17,28,46,.08); }
    .tab-intro { max-width: 760px; margin: -10px auto 25px; text-align: center; color: var(--muted); font-size: .92rem; }

    .calculator-grid { display: grid; gap: 22px; align-items: start; }
    .panel { background: var(--white); border: 1px solid rgba(188,195,204,.55); border-radius: var(--radius); box-shadow: var(--shadow); }
    .form-panel { padding: 20px; }
    .form-section + .form-section { padding-top: 24px; margin-top: 24px; border-top: 1px solid #E8EBEF; }
    .section-head { display: flex; align-items: flex-start; gap: 11px; margin-bottom: 17px; }
    .step-number { display: grid; place-items: center; flex: 0 0 30px; height: 30px; border-radius: 9px; color: var(--white); background: var(--midnight); font-size: .8rem; font-weight: 900; }
    .section-head h2, .section-head h3 { margin: 0; color: var(--midnight); font-size: 1.05rem; }
    .section-head p { margin: 3px 0 0; color: var(--muted); font-size: .82rem; }
    .field-grid { display: grid; gap: 15px; }
    .field { min-width: 0; }
    label, .field-label { display: block; margin-bottom: 7px; color: var(--graphite); font-size: .87rem; font-weight: 760; }
    .optional { color: var(--muted); font-weight: 550; font-size: .75rem; }
    .input-wrap { position: relative; }
    .prefix, .suffix { position: absolute; top: 50%; transform: translateY(-50%); color: #737D8C; font-size: .87rem; pointer-events: none; }
    .prefix { left: 13px; }
    .suffix { right: 13px; }
    input, select {
      width: 100%; min-height: 45px; border: 1px solid var(--border); border-radius: 11px;
      color: var(--graphite); background: var(--white); padding: 10px 12px; transition: border-color .15s, box-shadow .15s;
    }
    .has-prefix input { padding-left: 39px; }
    .has-suffix input { padding-right: 34px; }
    input:hover, select:hover { border-color: #AEB6C0; }
    input:focus, select:focus { border-color: var(--emerald); box-shadow: 0 0 0 3px rgba(21,154,114,.12); outline: none; }
    input[aria-invalid="true"] { border-color: var(--danger); }
    .helper { display: block; margin-top: 6px; color: var(--muted); font-size: .75rem; }
    .radio-group { display: grid; gap: 9px; margin-bottom: 15px; }
    .radio-card { display: flex; align-items: center; gap: 9px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; font-size: .84rem; }
    .radio-card input { width: 17px; min-height: 17px; height: 17px; accent-color: var(--emerald); }
    .details-card { border: 1px solid var(--border); border-radius: 13px; overflow: hidden; }
    .details-card summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px; color: var(--midnight); background: #FAFBFC; cursor: pointer; font-weight: 800; list-style: none; }
    .details-card summary::-webkit-details-marker { display: none; }
    .details-card summary svg { width: 18px; transition: transform .2s; }
    .details-card[open] summary svg { transform: rotate(180deg); }
    .details-body { padding: 15px; border-top: 1px solid var(--border); }
    .optional-pill { margin-left: auto; color: var(--emerald-dark); background: var(--mint); padding: 4px 7px; border-radius: 99px; font-size: .69rem; }
    .total-tax { display: flex; justify-content: space-between; gap: 16px; margin-top: 14px; padding: 11px 12px; border-radius: 10px; color: var(--midnight); background: #EEF1F4; font-size: .85rem; font-weight: 800; }
    .preset-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .preset { border: 1px solid var(--border); background: var(--white); color: var(--midnight); border-radius: 9px; padding: 7px 11px; font-size: .8rem; font-weight: 800; }
    .preset:hover { border-color: var(--emerald); color: var(--emerald-dark); }
    .info-box { display: flex; align-items: flex-start; gap: 9px; margin-top: 12px; padding: 11px 12px; background: #F0F4F6; border-radius: 10px; color: #53606F; font-size: .78rem; }
    .info-box svg { flex: 0 0 17px; margin-top: 1px; color: var(--emerald); }
    .error-box { display: none; margin: 16px 0 0; padding: 12px 14px; border: 1px solid #EAB3BA; border-radius: 10px; color: #862B36; background: var(--danger-soft); font-size: .84rem; font-weight: 650; }
    .error-box.is-visible { display: block; }
    .form-actions { display: grid; grid-template-columns: 1fr auto; gap: 10px; padding-top: 22px; }
    .button {
      min-height: 45px; display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      border: 1px solid transparent; border-radius: 11px; padding: 10px 15px; font-weight: 820;
    }
    .button svg { width: 18px; height: 18px; }
    .button-primary { color: var(--white); background: var(--emerald); box-shadow: 0 8px 18px rgba(21,154,114,.22); }
    .button-primary:hover { background: var(--emerald-dark); }
    .button-secondary { color: var(--midnight); background: var(--white); border-color: var(--border); }
    .button-secondary:hover { background: #F2F4F6; }
    .button-danger { color: var(--danger); background: var(--white); border-color: #E7B9BF; }

    .results-panel { overflow: hidden; }
    .result-header { padding: 19px 20px 17px; color: var(--white); background: var(--midnight); }
    .result-topline { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .result-kicker { margin: 0; color: var(--silver); font-size: .77rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .result-status { display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 999px; color: #A9E9D5; background: rgba(21,154,114,.16); font-size: .7rem; font-weight: 850; }
    .result-status.warning { color: #FFE1A2; background: rgba(154,101,14,.23); }
    .result-status.danger { color: #FFD4D9; background: rgba(178,58,72,.24); }
    .result-label { margin: 19px 0 2px; color: #E6EAEE; font-size: .86rem; }
    .main-price { margin: 0; color: #5AD0AB; font-size: clamp(2.2rem, 8vw, 3.35rem); font-weight: 900; line-height: 1.05; letter-spacing: -.045em; }
    .calculated-price-line { margin: 8px 0 0; color: #BEC6D0; font-size: .8rem; }
    .calculated-price-line strong { color: var(--white); }
    .result-body { padding: 20px; }
    .result-placeholder { min-height: 330px; display: grid; place-items: center; text-align: center; color: var(--muted); }
    .placeholder-icon { width: 64px; height: 64px; display: grid; place-items: center; margin: 0 auto 14px; border-radius: 18px; color: var(--emerald); background: var(--mint); }
    .placeholder-icon svg { width: 31px; }
    .result-placeholder p { max-width: 300px; margin: 0; font-size: .9rem; }
    .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0 0 20px; }
    .metric { padding: 12px; border: 1px solid #E3E7EB; border-radius: 11px; background: #FBFCFD; }
    .metric dt { color: var(--muted); font-size: .72rem; }
    .metric dd { margin: 3px 0 0; color: var(--midnight); font-weight: 850; }
    .metric dd.positive { color: var(--emerald-dark); }
    .metric dd.negative { color: var(--danger); }
    .composition { display: grid; grid-template-columns: 116px 1fr; align-items: center; gap: 18px; padding-top: 18px; border-top: 1px solid #E7EAEE; }
    .donut { position: relative; width: 116px; aspect-ratio: 1; border-radius: 50%; background: conic-gradient(var(--silver) 0 33%, #6F7B8A 33% 66%, var(--emerald) 66% 100%); }
    .donut::after { content: ""; position: absolute; inset: 23px; border-radius: 50%; background: var(--white); }
    .donut-center { position: absolute; inset: 0; z-index: 1; display: grid; place-content: center; text-align: center; color: var(--muted); font-size: .65rem; }
    .donut-center strong { display: block; color: var(--midnight); font-size: .91rem; }
    .legend { display: grid; gap: 8px; }
    .legend-row { display: grid; grid-template-columns: auto 1fr auto; gap: 7px; align-items: center; font-size: .75rem; }
    .dot { width: 8px; height: 8px; border-radius: 50%; }
    .dot-cost { background: var(--silver); }
    .dot-fee { background: #6F7B8A; }
    .dot-profit { background: var(--emerald); }
    .legend-row strong { color: var(--midnight); font-size: .73rem; }
    .discount-note { margin-top: 17px; padding: 11px 12px; border-radius: 10px; color: var(--emerald-dark); background: var(--mint); font-size: .8rem; font-weight: 750; }
    .projection { margin-top: 18px; padding-top: 18px; border-top: 1px solid #E7EAEE; }
    .projection h3 { margin: 0 0 11px; color: var(--midnight); font-size: .94rem; }
    .projection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .projection-item { padding: 10px; border-radius: 9px; background: #F2F4F6; }
    .projection-item span { display: block; color: var(--muted); font-size: .68rem; }
    .projection-item strong { color: var(--midnight); font-size: .84rem; }
    .simulation-note { margin: 10px 0 0; color: var(--muted); font-size: .7rem; }
    .result-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 18px; }
    .result-actions .button:last-child { grid-column: 1 / -1; }

    .calculation-details { margin-top: 22px; }
    .calculation-details summary { padding: 16px 18px; }
    .calculation-details .details-body { padding: 6px 18px 16px; }
    .breakdown { margin: 0; }
    .breakdown-row { display: grid; grid-template-columns: 28px 1fr auto; gap: 9px; align-items: center; padding: 10px 0; border-bottom: 1px solid #ECEFF2; }
    .breakdown-row:last-child { border-bottom: 0; }
    .breakdown-row .index { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 7px; color: var(--muted); background: #EEF1F4; font-size: .67rem; font-weight: 850; }
    .breakdown-row dt { font-size: .82rem; }
    .breakdown-row dd { margin: 0; color: var(--midnight); font-size: .82rem; font-weight: 800; }

    .education { display: grid; gap: 18px; margin-top: 30px; }
    .education-card { padding: 22px; }
    .education-card h2 { margin: 0 0 10px; color: var(--midnight); font-size: 1.25rem; letter-spacing: -.02em; }
    .education-card p { margin: 0; color: #566170; font-size: .91rem; }
    .check-list { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 9px 14px; padding: 0; margin: 15px 0 0; list-style: none; }
    .check-list li { display: flex; align-items: center; gap: 8px; color: #4F5A68; font-size: .83rem; }
    .check-list svg { flex: 0 0 16px; color: var(--emerald); }
    .notices { margin-top: 20px; padding: 19px 20px; border: 1px solid #E0E4E9; border-radius: 14px; background: #EEF1F4; }
    .notices p { margin: 0; color: #596473; font-size: .78rem; }
    .notices p + p { margin-top: 7px; }

    .site-footer { padding: 28px 0; color: #C9D0D9; background: var(--midnight); }
    .footer-grid { display: grid; gap: 17px; }
    .footer-main { margin: 0; color: var(--white); font-weight: 780; }
    .footer-legal { max-width: 780px; margin: 6px 0 0; color: #AEB7C2; font-size: .78rem; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 13px 20px; font-size: .8rem; }
    .footer-links a { color: #96E0C9; }

    .drawer-backdrop { position: fixed; inset: 0; z-index: 300; display: none; background: rgba(17,28,46,.55); }
    .drawer-backdrop.is-open { display: block; }
    .history-drawer { position: fixed; top: 0; right: 0; z-index: 310; width: min(620px, 100%); height: 100dvh; padding: 0; border: 0; transform: translateX(102%); transition: transform .25s ease; background: var(--ice); box-shadow: -20px 0 50px rgba(17,28,46,.2); }
    .history-drawer.is-open { transform: translateX(0); }
    .drawer-head { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 18px 20px; color: var(--white); background: var(--midnight); }
    .drawer-head h2 { margin: 0; font-size: 1.2rem; }
    .icon-button { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid rgba(255,255,255,.2); border-radius: 10px; color: var(--white); background: rgba(255,255,255,.08); }
    .icon-button svg { width: 20px; }
    .drawer-body { height: calc(100dvh - 76px); overflow: auto; padding: 18px 20px 30px; }
    .history-toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px; }
    .history-list { display: grid; gap: 11px; }
    .history-empty { padding: 50px 15px; text-align: center; color: var(--muted); }
    .history-item { padding: 15px; border: 1px solid var(--border); border-radius: 13px; background: var(--white); }
    .history-item-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .history-item h3 { margin: 0; color: var(--midnight); font-size: .98rem; }
    .history-item small { color: var(--muted); }
    .history-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 13px 0; }
    .history-value { padding: 8px; border-radius: 8px; background: #F0F3F5; }
    .history-value span { display: block; color: var(--muted); font-size: .65rem; }
    .history-value strong { color: var(--midnight); font-size: .78rem; }
    .history-actions { display: flex; flex-wrap: wrap; gap: 7px; }
    .mini-button { border: 1px solid var(--border); border-radius: 8px; color: var(--midnight); background: var(--white); padding: 7px 9px; font-size: .72rem; font-weight: 780; }
    .mini-button.delete { color: var(--danger); }
    .toast { position: fixed; left: 50%; bottom: 22px; z-index: 500; max-width: calc(100% - 32px); transform: translate(-50%, 25px); opacity: 0; pointer-events: none; padding: 11px 16px; border-radius: 10px; color: var(--white); background: var(--midnight); box-shadow: var(--shadow); font-size: .84rem; font-weight: 750; transition: .2s ease; }
    .toast.is-visible { transform: translate(-50%, 0); opacity: 1; }

    @media (min-width: 640px) {
      .exclusive { display: inline-flex; }
      .field-grid.two { grid-template-columns: 1fr 1fr; }
      .field-grid.three { grid-template-columns: repeat(3, 1fr); }
      .form-panel { padding: 26px; }
      .education { grid-template-columns: 1.1fr .9fr; }
      .footer-grid { grid-template-columns: 1fr auto; align-items: end; }
      .footer-links { justify-content: flex-end; }
    }
    @media (min-width: 980px) {
      .calculator-grid { grid-template-columns: minmax(0, 1.35fr) minmax(350px, .65fr); }
      .results-panel { position: sticky; top: 98px; }
      .hero { padding: 58px 0 44px; }
      .education-card { padding: 28px; }
    }
    @media (max-width: 520px) {
      .container { width: min(100% - 22px, 1180px); }
      .header-inner { min-height: 66px; }
      .brand img { width: 152px; height: 35px; padding: 3px 6px; }
      .brand small { font-size: .58rem; }
      .header-button span { display: none; }
      .header-button { padding: 10px; }
      .hero { padding-top: 38px; }
      .mode-tabs { font-size: .78rem; }
      .tab-button { padding-inline: 6px; }
      .form-actions { grid-template-columns: 1fr; }
      .metrics, .projection-grid { grid-template-columns: 1fr 1fr; }
      .composition { grid-template-columns: 96px 1fr; gap: 13px; }
      .donut { width: 96px; }
      .donut::after { inset: 19px; }
      .check-list { grid-template-columns: 1fr; }
      .history-values { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
    }
    @media print {
      @page { margin: 14mm; }
      body { background: white; color: black; font-size: 10pt; }
      .site-header, .hero, .mode-tabs, .tab-intro, .form-actions, .result-actions, .education, .notices, .site-footer, .drawer-backdrop, .history-drawer, .toast, .details-card:not(.calculation-details), .optional:empty { display: none !important; }
      main { padding: 0; }
      .container { width: 100%; }
      .calculator-grid { display: block; }
      .form-panel { box-shadow: none; border: 0; padding: 0; margin-bottom: 18px; }
      .form-section { display: none; }
      .form-section:first-child { display: block; }
      .form-section:first-child .field:has(input:placeholder-shown), .form-section:first-child .field:has(select option[value=""]:checked) { display: none; }
      .results-panel { box-shadow: none; border: 1px solid #bbb; break-inside: avoid; }
      .result-header { color: white !important; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .result-placeholder { display: none !important; }
      .result-content { display: block !important; }
      .calculation-details { display: block; box-shadow: none; margin-top: 16px; }
      .calculation-details summary { display: none; }
      .calculation-details .details-body { display: block; border: 0; }
      .print-brand { display: block !important; margin-bottom: 4px; color: #111C2E; font-size: 16pt; font-weight: 900; }
      .print-date { display: block !important; margin-bottom: 12px; color: #596473; font-size: 9pt; }
      .composition { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#calculadora">Ir para a calculadora</a>

  <header class="site-header">
    <div class="container header-inner">
      <div class="brand" aria-label="Calculadora da Prata">
        <img id="brandLogo" src="assets/logo-calculadora-da-prata.png" data-fallback-logo="data:image/png;base64," alt="Calculadora da Prata" onerror="if(this.dataset.fallbackLogo){var fallback=this.dataset.fallbackLogo;delete this.dataset.fallbackLogo;this.src=fallback}else{this.hidden=true;document.getElementById('brandFallback').hidden=false}">
        <div class="brand-copy">
          <span id="brandFallback" class="brand-fallback" hidden>CALCULADORA DA PRATA</span>
          <small>Um produto Mapa da Prata 925</small>
        </div>
      </div>
      <div class="header-actions">
        <span class="exclusive">Área exclusiva</span>
        <button class="header-button" id="openHistory" type="button" aria-controls="historyDrawer" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5M12 7v5l3 2"/></svg>
          <span>Meus cálculos</span>
        </button>
      </div>
    </div>
  </header>

  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">Precificação simples e consciente</p>
      <h1>Descubra quanto cobrar por cada peça</h1>
      <p class="hero-lead">Calcule seus custos, defina sua margem e encontre um preço de venda que proteja o lucro do seu negócio.</p>
      <ul class="benefits" aria-label="Benefícios">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>Cálculo automático</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>Margem real</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>Dados salvos no seu dispositivo</li>
      </ul>
      <p class="hero-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>Você não precisa entender de fórmulas. Preencha os campos e a calculadora fará as contas para você.</p>
    </div>
  </section>

  <main id="calculadora">
    <div class="container">
      <div class="mode-tabs" role="tablist" aria-label="Modo da calculadora">
        <button class="tab-button" id="tabIdeal" type="button" role="tab" aria-selected="true" aria-controls="calculatorForm" data-mode="ideal">Calcular preço ideal</button>
        <button class="tab-button" id="tabAnalyze" type="button" role="tab" aria-selected="false" aria-controls="calculatorForm" data-mode="analyze">Analisar meu preço</button>
      </div>
      <p class="tab-intro" id="modeDescription">Use esta opção quando você ainda não definiu o preço e deseja descobrir quanto precisa cobrar para alcançar determinada margem.</p>

      <div class="calculator-grid">
        <form class="panel form-panel" id="calculatorForm" novalidate>
          <section class="form-section" aria-labelledby="pieceHeading">
            <div class="section-head">
              <span class="step-number">1</span>
              <div><h2 id="pieceHeading">Identificação da peça</h2><p>Opcional — use para organizar os cálculos salvos.</p></div>
            </div>
            <div class="field-grid three">
              <div class="field"><label for="pieceName">Nome da peça <span class="optional">(opcional)</span></label><input id="pieceName" name="pieceName" type="text" maxlength="80" placeholder="Ex.: Colar ponto de luz"></div>
              <div class="field"><label for="sku">Código ou SKU <span class="optional">(opcional)</span></label><input id="sku" name="sku" type="text" maxlength="40" placeholder="Ex.: COL-001"></div>
              <div class="field"><label for="category">Categoria <span class="optional">(opcional)</span></label><select id="category" name="category"><option value="">Selecione</option><option>Anel</option><option>Brinco</option><option>Colar</option><option>Corrente</option><option>Pulseira</option><option>Pingente</option><option>Tornozeleira</option><option>Aliança</option><option>Conjunto</option><option>Outro</option></select></div>
            </div>
          </section>

          <section class="form-section" aria-labelledby="costHeading">
            <div class="section-head">
              <span class="step-number">2</span>
              <div><h2 id="costHeading">Custo da peça</h2><p>Inclua tudo o que é necessário para colocar uma unidade à venda.</p></div>
            </div>
            <div class="field-grid two">
              <div class="field">
                <label for="pieceCost">Custo de compra da peça</label>
                <div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="pieceCost" name="pieceCost" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money required aria-describedby="pieceCostHelp"></div>
                <small class="helper" id="pieceCostHelp">Quanto você pagou ao fornecedor por uma unidade?</small>
              </div>
              <div class="field">
                <label for="packaging">Embalagem por peça</label>
                <div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="packaging" name="packaging" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money></div>
                <small class="helper">Caixinha, saquinho, flanela, tag, cartão e outros materiais utilizados na entrega.</small>
              </div>
            </div>

            <div class="field" style="margin-top:17px">
              <span class="field-label">Frete da compra</span>
              <div class="radio-group" role="radiogroup" aria-label="Forma de informar o frete">
                <label class="radio-card"><input type="radio" name="freightMode" value="unit" checked>Informar frete por unidade</label>
                <label class="radio-card"><input type="radio" name="freightMode" value="total">Dividir frete total entre as peças</label>
              </div>
            </div>
            <div id="freightUnitFields" class="field-grid">
              <div class="field"><label for="freightUnit">Frete por unidade</label><div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="freightUnit" name="freightUnit" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money></div></div>
            </div>
            <div id="freightTotalFields" class="field-grid two" hidden>
              <div class="field"><label for="freightTotal">Valor total do frete</label><div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="freightTotal" name="freightTotal" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money></div></div>
              <div class="field"><label for="receivedQuantity">Quantidade de peças recebidas</label><input id="receivedQuantity" name="receivedQuantity" type="text" inputmode="numeric" autocomplete="off" placeholder="Ex.: 10" data-integer><small class="helper">Deve ser maior que zero.</small></div>
            </div>

            <div class="field-grid two" style="margin-top:17px">
              <div class="field"><label for="otherCosts">Outros custos por peça</label><div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="otherCosts" name="otherCosts" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money></div><small class="helper">Brindes, etiqueta, limpeza, transporte ou qualquer outro custo unitário.</small></div>
              <div class="field"><label for="fixedFee">Taxa fixa por venda</label><div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="fixedFee" name="fixedFee" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money></div><small class="helper">Valor fixo cobrado a cada venda, além das taxas percentuais.</small></div>
            </div>
          </section>

          <section class="form-section" aria-labelledby="ratesHeading">
            <div class="section-head">
              <span class="step-number">3</span>
              <div><h2 id="ratesHeading">Taxas sobre a venda</h2><p>Preencha apenas as taxas que fazem parte da sua operação.</p></div>
            </div>
            <details class="details-card" id="ratesDetails">
              <summary>Adicionar taxas percentuais <span class="optional-pill">Opcional</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
              <div class="details-body">
                <div class="field-grid two">
                  <div class="field"><label for="paymentRate">Taxa de pagamento ou cartão</label><div class="input-wrap has-suffix"><input id="paymentRate" name="paymentRate" type="text" inputmode="decimal" autocomplete="off" value="0" data-percent><span class="suffix">%</span></div></div>
                  <div class="field"><label for="marketplaceRate">Comissão de marketplace</label><div class="input-wrap has-suffix"><input id="marketplaceRate" name="marketplaceRate" type="text" inputmode="decimal" autocomplete="off" value="0" data-percent><span class="suffix">%</span></div></div>
                  <div class="field"><label for="taxRate">Impostos sobre a venda</label><div class="input-wrap has-suffix"><input id="taxRate" name="taxRate" type="text" inputmode="decimal" autocomplete="off" value="0" data-percent><span class="suffix">%</span></div></div>
                  <div class="field"><label for="commissionRate">Comissão de vendedor ou afiliado</label><div class="input-wrap has-suffix"><input id="commissionRate" name="commissionRate" type="text" inputmode="decimal" autocomplete="off" value="0" data-percent><span class="suffix">%</span></div></div>
                  <div class="field"><label for="discountReserve">Reserva para descontos e promoções</label><div class="input-wrap has-suffix"><input id="discountReserve" name="discountReserve" type="text" inputmode="decimal" autocomplete="off" value="0" data-percent><span class="suffix">%</span></div></div>
                </div>
                <p class="info-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>Essas taxas são calculadas sobre o preço final de venda. Se você não tiver alguma delas, deixe o campo em zero.</p>
                <div class="total-tax"><span>Percentual total de taxas</span><strong id="totalRateDisplay">0%</strong></div>
              </div>
            </details>
          </section>

          <section class="form-section" aria-labelledby="strategyHeading">
            <div class="section-head">
              <span class="step-number">4</span>
              <div><h2 id="strategyHeading">Estratégia de venda</h2><p id="strategyDescription">Defina a margem que você deseja preservar no preço.</p></div>
            </div>
            <div class="ideal-only">
              <div class="field">
                <label for="desiredMargin">Margem de lucro desejada</label>
                <div class="input-wrap has-suffix"><input id="desiredMargin" name="desiredMargin" type="text" inputmode="decimal" autocomplete="off" value="40" data-percent><span class="suffix">%</span></div>
                <div class="preset-row" aria-label="Atalhos de margem"><button class="preset" type="button" data-margin="20">20%</button><button class="preset" type="button" data-margin="30">30%</button><button class="preset" type="button" data-margin="40">40%</button><button class="preset" type="button" data-margin="50">50%</button><button class="preset" type="button" data-margin="60">60%</button></div>
                <p class="info-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>Margem é a porcentagem do preço de venda que permanece como lucro depois dos custos e das taxas. Margem não é a mesma coisa que simplesmente acrescentar uma porcentagem ao custo.</p>
              </div>
              <div class="field" style="margin-top:17px">
                <label for="rounding">Arredondamento comercial</label>
                <select id="rounding" name="rounding"><option value="none">Sem arredondamento</option><option value="90">Próximo valor terminado em ,90</option><option value="99">Próximo valor terminado em ,99</option><option value="integer">Próximo real inteiro</option><option value="5">Próximo múltiplo de R$ 5,00</option></select>
                <small class="helper">O arredondamento é sempre para cima e nunca reduz o valor matematicamente necessário.</small>
              </div>
            </div>
            <div class="analyze-only" hidden>
              <div class="field-grid two">
                <div class="field"><label for="practicedPrice">Preço de venda praticado</label><div class="input-wrap has-prefix"><span class="prefix">R$</span><input id="practicedPrice" name="practicedPrice" type="text" inputmode="decimal" autocomplete="off" placeholder="0,00" data-money></div></div>
                <div class="field"><label for="targetMargin">Minha meta de margem <span class="optional">(opcional)</span></label><div class="input-wrap has-suffix"><input id="targetMargin" name="targetMargin" type="text" inputmode="decimal" autocomplete="off" placeholder="Ex.: 40" data-percent><span class="suffix">%</span></div></div>
              </div>
            </div>
            <div class="field" style="margin-top:17px"><label for="salesQuantity">Quantas peças você pretende vender?</label><input id="salesQuantity" name="salesQuantity" type="text" inputmode="numeric" autocomplete="off" value="10" data-integer><small class="helper">Essa projeção é uma simulação, não uma garantia de resultado.</small></div>
          </section>

          <div class="error-box" id="errorBox" role="alert" tabindex="-1"></div>
          <div class="form-actions">
            <button class="button button-primary" id="calculateButton" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16v16H4zM8 8h8M8 12h2M14 12h2M8 16h2M14 16h2"/></svg>Calcular</button>
            <button class="button button-secondary" id="clearButton" type="button">Limpar</button>
          </div>
        </form>

        <aside class="panel results-panel" aria-live="polite" aria-label="Resultados do cálculo">
          <div class="result-header">
            <div class="result-topline"><p class="result-kicker">Resultado da peça</p><span class="result-status" id="resultStatus">Aguardando dados</span></div>
            <p class="result-label" id="mainPriceLabel">Preço de venda sugerido</p>
            <p class="main-price" id="mainPrice">R$ 0,00</p>
            <p class="calculated-price-line ideal-only" id="calculatedPriceLine">Preço calculado: <strong id="calculatedPrice">R$ 0,00</strong></p>
          </div>
          <div class="result-body">
            <div class="result-placeholder" id="resultPlaceholder">
              <div><span class="placeholder-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 7h8M8 11h2M14 11h2M8 15h2M14 15h2"/></svg></span><p>Preencha os campos obrigatórios e selecione “Calcular” para ver o resultado.</p></div>
            </div>
            <div class="result-content" id="resultContent" hidden>
              <dl class="metrics">
                <div class="metric"><dt>Custo unitário total</dt><dd id="metricCost">R$ 0,00</dd></div>
                <div class="metric"><dt>Taxas estimadas</dt><dd id="metricFees">R$ 0,00</dd></div>
                <div class="metric"><dt>Lucro líquido por peça</dt><dd id="metricProfit">R$ 0,00</dd></div>
                <div class="metric"><dt>Margem real</dt><dd id="metricMargin">0%</dd></div>
                <div class="metric"><dt>Preço de equilíbrio</dt><dd id="metricBreakEven">R$ 0,00</dd></div>
                <div class="metric"><dt>Markup multiplicador</dt><dd id="metricMarkup">0,00x</dd></div>
                <div class="metric"><dt>Markup percentual</dt><dd id="metricMarkupPercent">0,00%</dd></div>
              </dl>
              <div class="composition" id="compositionBlock">
                <div class="donut" id="donut"><span class="donut-center">Composição<strong>100%</strong></span></div>
                <div class="legend" aria-label="Composição do preço">
                  <div class="legend-row"><span class="dot dot-cost"></span><span>Custos</span><strong id="legendCost">R$ 0,00 · 0%</strong></div>
                  <div class="legend-row"><span class="dot dot-fee"></span><span>Taxas</span><strong id="legendFees">R$ 0,00 · 0%</strong></div>
                  <div class="legend-row"><span class="dot dot-profit"></span><span>Lucro</span><strong id="legendProfit">R$ 0,00 · 0%</strong></div>
                </div>
              </div>
              <p class="info-box" id="invalidComposition" hidden>O gráfico de composição não é exibido quando há valor negativo ou cenário inválido.</p>
              <div class="discount-note" id="discountNote">Este preço não possui margem disponível para desconto.</div>
              <section class="projection" aria-labelledby="projectionHeading">
                <h3 id="projectionHeading">Projeção de vendas</h3>
                <div class="projection-grid">
                  <div class="projection-item"><span>Faturamento projetado</span><strong id="projectedRevenue">R$ 0,00</strong></div>
                  <div class="projection-item"><span>Custo total</span><strong id="projectedCost">R$ 0,00</strong></div>
                  <div class="projection-item"><span>Taxas totais</span><strong id="projectedFees">R$ 0,00</strong></div>
                  <div class="projection-item"><span>Lucro líquido projetado</span><strong id="projectedProfit">R$ 0,00</strong></div>
                </div>
                <p class="simulation-note">Simulação baseada na quantidade informada. Não representa garantia de vendas ou lucro.</p>
              </section>
              <div class="result-actions">
                <button class="button button-primary" id="saveButton" type="button">Salvar cálculo</button>
                <button class="button button-secondary" id="copyButton" type="button">Copiar resumo</button>
                <button class="button button-secondary" id="printButton" type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 9V3h10v6M7 18H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M7 14h10v7H7z"/></svg>Imprimir resumo</button>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <details class="panel details-card calculation-details" id="calculationDetails">
        <summary>Entenda o cálculo <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="details-body"><span class="print-brand" hidden>CALCULADORA DA PRATA — Mapa da Prata 925</span><span class="print-date" id="printDate" hidden></span><dl class="breakdown" id="breakdown"></dl><p class="info-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>Markup mostra quanto o preço representa em relação ao custo. Margem mostra quanto do preço de venda permanece como lucro. São indicadores diferentes.</p></div>
      </details>

      <section class="education" aria-label="Conteúdo educativo">
        <article class="panel education-card">
          <p class="eyebrow" style="color:var(--emerald-dark)">Conceito essencial</p>
          <h2>Margem não é a mesma coisa que acréscimo</h2>
          <p>Se uma peça custa R$ 100,00 e você acrescenta 50%, o preço será R$ 150,00. Nesse caso, o lucro de R$ 50,00 representa apenas 33,33% do preço de venda. Para obter uma margem real de 50%, sem outras taxas, o preço necessário seria R$ 200,00.</p>
        </article>
        <article class="panel education-card">
          <p class="eyebrow" style="color:var(--emerald-dark)">Checklist</p>
          <h2>O que não esquecer ao precificar</h2>
          <ul class="check-list">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>frete da compra</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>embalagem</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>brindes</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>taxas de cartão</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>comissões</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>impostos</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>custos de marketplace</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>descontos</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>trocas e perdas</li><li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg>tempo e operação do negócio</li>
          </ul>
        </article>
      </section>

      <section class="notices" aria-label="Avisos importantes">
        <p>A Calculadora da Prata é uma ferramenta de apoio à organização e à precificação. Os resultados são estimativas baseadas nos dados informados pela usuária.</p>
        <p>Margens, custos e condições de mercado variam de acordo com cada negócio.</p>
        <p>Para orientações fiscais e tributárias, consulte um profissional de contabilidade.</p>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container footer-grid">
      <div><p class="footer-main">© 2026 Calculadora da Prata — Mapa da Prata 925. Todos os direitos reservados.</p><p class="footer-legal">Material exclusivo para uso da compradora. É proibida a reprodução, revenda, distribuição ou disponibilização do link de acesso sem autorização.</p></div>
      <div class="footer-links"><span>Instagram: @[INSERIR NOVO INSTAGRAM]</span><a href="mailto:materiaisdigitaisltda@gmail.com">materiaisdigitaisltda@gmail.com</a></div>
    </div>
  </footer>

  <div class="drawer-backdrop" id="drawerBackdrop"></div>
  <aside class="history-drawer" id="historyDrawer" aria-labelledby="historyTitle" aria-hidden="true">
    <div class="drawer-head"><h2 id="historyTitle">Meus cálculos</h2><button class="icon-button" id="closeHistory" type="button" aria-label="Fechar histórico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <div class="drawer-body">
      <div class="history-toolbar"><button class="button button-secondary" id="exportCsv" type="button">Exportar histórico em CSV</button><button class="button button-danger" id="clearHistory" type="button">Apagar todo o histórico</button></div>
      <div class="history-list" id="historyList"></div>
    </div>
  </aside>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script id="calculator-core">
    (function (root) {
      "use strict";
      function finite(value) { return Number.isFinite(value) ? value : 0; }
      function roundMoney(value) { return Math.round((finite(value) + Number.EPSILON) * 100) / 100; }
      function parseLocaleNumber(value) {
        if (typeof value === "number") return value >= 0 && Number.isFinite(value) ? value : NaN;
        var text = String(value == null ? "" : value).trim().replace(/\s/g, "").replace(/R\$/gi, "").replace(/%/g, "");
        if (!text) return 0;
        if (text.indexOf("-") !== -1) return NaN;
        text = text.replace(/[^0-9.,]/g, "");
        var lastComma = text.lastIndexOf(",");
        var lastDot = text.lastIndexOf(".");
        var decimalAt = Math.max(lastComma, lastDot);
        if (decimalAt >= 0) {
          var decimals = text.length - decimalAt - 1;
          var separators = (text.match(/[.,]/g) || []).length;
          if (decimals <= 2 || separators > 1) text = text.slice(0, decimalAt).replace(/[.,]/g, "") + "." + text.slice(decimalAt + 1).replace(/[.,]/g, "");
          else text = text.replace(/[.,]/g, "");
        }
        var parsed = Number(text);
        return Number.isFinite(parsed) && parsed >= 0 ? parsed : NaN;
      }
      function applyRounding(value, type) {
        value = finite(value);
        if (type === "none") return value;
        if (type === "integer") return Math.ceil(value - 1e-9);
        if (type === "5") return Math.ceil((value - 1e-9) / 5) * 5;
        var target = type === "90" ? 90 : 99;
        var cents = Math.ceil(value * 100 - 1e-7);
        var whole = Math.floor(cents / 100);
        var candidate = whole * 100 + target;
        if (candidate < cents) candidate += 100;
        return candidate / 100;
      }
      function compute(input) {
        var freightUnit = input.freightMode === "total" ? input.freightTotal / input.receivedQuantity : input.freightUnit;
        var cost = input.pieceCost + freightUnit + input.packaging + input.otherCosts + input.fixedFee;
        var totalRatePercent = input.paymentRate + input.marketplaceRate + input.taxRate + input.commissionRate + input.discountReserve;
        var rate = totalRatePercent / 100;
        if (![freightUnit, cost, rate].every(Number.isFinite)) return { error: "Valores inválidos." };
        if (input.freightMode === "total" && input.receivedQuantity <= 0) return { error: "A quantidade de peças recebidas deve ser maior que zero." };
        if (totalRatePercent >= 100) return { error: "O percentual total de taxas precisa ser menor que 100%." };
        var breakEven = cost / (1 - rate);
        var calculatedPrice;
        var salePrice;
        if (input.mode === "ideal") {
          if (input.desiredMargin + totalRatePercent >= 100) return { error: "Não é possível calcular esse cenário. A soma da margem desejada com as taxas precisa ser menor que 100%." };
          calculatedPrice = cost / (1 - rate - input.desiredMargin / 100);
          salePrice = applyRounding(calculatedPrice, input.rounding);
        } else {
          calculatedPrice = input.practicedPrice;
          salePrice = input.practicedPrice;
        }
        var feeValue = salePrice * rate;
        var profit = salePrice - cost - feeValue;
        var margin = salePrice > 0 ? profit / salePrice * 100 : 0;
        var markupMultiplier = cost > 0 ? salePrice / cost : 0;
        var markupPercent = cost > 0 ? (salePrice - cost) / cost * 100 : 0;
        var discount = salePrice > 0 ? Math.max(0, (1 - breakEven / salePrice) * 100) : 0;
        var quantity = Math.max(0, Math.floor(input.salesQuantity || 0));
        var status = "Margem positiva";
        if (profit < -0.005) status = "Prejuízo";
        else if (Math.abs(profit) <= 0.005) status = "No ponto de equilíbrio";
        else if (input.mode === "ideal" || (Number.isFinite(input.targetMargin) && input.targetMargin > 0 && margin + 1e-7 >= input.targetMargin)) status = "Meta de margem atingida";
        return {
          freightUnit: roundMoney(freightUnit), cost: roundMoney(cost), totalRatePercent: totalRatePercent,
          calculatedPrice: roundMoney(calculatedPrice), salePrice: roundMoney(salePrice), feeValue: roundMoney(feeValue),
          profit: roundMoney(profit), margin: margin, breakEven: roundMoney(breakEven), markupMultiplier: markupMultiplier,
          markupPercent: markupPercent, discount: discount, status: status, quantity: quantity,
          projectedRevenue: roundMoney(salePrice * quantity), projectedCost: roundMoney(cost * quantity),
          projectedFees: roundMoney(feeValue * quantity), projectedProfit: roundMoney(profit * quantity)
        };
      }
      root.CalculadoraDaPrataCore = { parseLocaleNumber: parseLocaleNumber, applyRounding: applyRounding, compute: compute };
    })(typeof window !== "undefined" ? window : globalThis);
  </script>

  <script>
    (function () {
      "use strict";
      var core = window.CalculadoraDaPrataCore;
      var form = document.getElementById("calculatorForm");
      var mode = "ideal";
      var lastResult = null;
      var hasCalculated = false;
      var storageKey = "calculadoraDaPrataHistoricoV1";
      var toastTimer;
      var currency = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
      var number2 = new Intl.NumberFormat("pt-BR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      function byId(id) { return document.getElementById(id); }
      function money(value) { return currency.format(Number.isFinite(value) ? value : 0); }
      function pct(value) { return number2.format(Number.isFinite(value) ? value : 0) + "%"; }
      function safe(value) { var n = core.parseLocaleNumber(value); return Number.isFinite(n) ? n : NaN; }
      function fieldNumber(id) { return safe(byId(id).value); }
      function allFinite(values) { return values.every(Number.isFinite); }
      function showToast(message) { clearTimeout(toastTimer); var el = byId("toast"); el.textContent = message; el.classList.add("is-visible"); toastTimer = setTimeout(function () { el.classList.remove("is-visible"); }, 2600); }
      function setError(message, focus) { var box = byId("errorBox"); box.textContent = message; box.classList.toggle("is-visible", Boolean(message)); if (message && focus) box.focus(); }
      function clearInvalid() { form.querySelectorAll("[aria-invalid='true']").forEach(function (el) { el.removeAttribute("aria-invalid"); }); }
      function invalid(id) { byId(id).setAttribute("aria-invalid", "true"); }

      function collectInput() {
        var targetRaw = byId("targetMargin").value.trim();
        return {
          mode: mode,
          pieceCost: fieldNumber("pieceCost"), packaging: fieldNumber("packaging"), otherCosts: fieldNumber("otherCosts"), fixedFee: fieldNumber("fixedFee"),
          freightMode: form.elements.freightMode.value, freightUnit: fieldNumber("freightUnit"), freightTotal: fieldNumber("freightTotal"), receivedQuantity: fieldNumber("receivedQuantity"),
          paymentRate: fieldNumber("paymentRate"), marketplaceRate: fieldNumber("marketplaceRate"), taxRate: fieldNumber("taxRate"), commissionRate: fieldNumber("commissionRate"), discountReserve: fieldNumber("discountReserve"),
          desiredMargin: fieldNumber("desiredMargin"), rounding: byId("rounding").value, practicedPrice: fieldNumber("practicedPrice"),
          targetMargin: targetRaw ? fieldNumber("targetMargin") : NaN, salesQuantity: fieldNumber("salesQuantity")
        };
      }

      function validate(input) {
        clearInvalid();
        var numeric = [input.pieceCost, input.packaging, input.otherCosts, input.fixedFee, input.freightUnit, input.freightTotal, input.receivedQuantity, input.paymentRate, input.marketplaceRate, input.taxRate, input.commissionRate, input.discountReserve, input.desiredMargin, input.practicedPrice, input.salesQuantity];
        if (!allFinite(numeric)) return "Use apenas valores válidos e não negativos.";
        if (input.pieceCost <= 0) { invalid("pieceCost"); return "Informe um custo de compra maior que zero para calcular."; }
        if (input.freightMode === "total" && input.receivedQuantity <= 0) { invalid("receivedQuantity"); return "A quantidade de peças recebidas deve ser maior que zero."; }
        if (input.salesQuantity <= 0) { invalid("salesQuantity"); return "A quantidade pretendida para venda deve ser maior que zero."; }
        var totalRates = input.paymentRate + input.marketplaceRate + input.taxRate + input.commissionRate + input.discountReserve;
        if (totalRates >= 100) return "O percentual total de taxas precisa ser menor que 100%.";
        if (mode === "ideal" && input.desiredMargin + totalRates >= 100) return "Não é possível calcular esse cenário. A soma da margem desejada com as taxas precisa ser menor que 100%.";
        if (mode === "analyze" && input.practicedPrice <= 0) { invalid("practicedPrice"); return "Informe um preço de venda praticado maior que zero."; }
        if (byId("targetMargin").value.trim() && !Number.isFinite(input.targetMargin)) { invalid("targetMargin"); return "Informe uma meta de margem válida e não negativa."; }
        return "";
      }

      function calculate(options) {
        options = options || {};
        var input = collectInput();
        var validation = validate(input);
        updateTotalRate();
        if (validation) {
          setError(validation, options.focusError);
          lastResult = null;
          if (!options.silent) hideResults();
          return null;
        }
        var result = core.compute(input);
        if (result.error) { setError(result.error, options.focusError); lastResult = null; hideResults(); return null; }
        setError("");
        lastResult = { input: input, result: result };
        hasCalculated = true;
        renderResult(result);
        renderBreakdown(input, result);
        return result;
      }

      function hideResults() {
        byId("resultPlaceholder").hidden = false;
        byId("resultContent").hidden = true;
        byId("mainPrice").textContent = money(0);
        byId("calculatedPrice").textContent = money(0);
        byId("resultStatus").textContent = "Aguardando dados";
        byId("resultStatus").className = "result-status";
      }

      function renderResult(r) {
        byId("resultPlaceholder").hidden = true;
        byId("resultContent").hidden = false;
        byId("mainPrice").textContent = money(r.salePrice);
        byId("calculatedPrice").textContent = money(r.calculatedPrice);
        byId("metricCost").textContent = money(r.cost);
        byId("metricFees").textContent = money(r.feeValue);
        byId("metricProfit").textContent = money(r.profit);
        byId("metricProfit").className = r.profit < 0 ? "negative" : "positive";
        byId("metricMargin").textContent = pct(r.margin);
        byId("metricMargin").className = r.margin < 0 ? "negative" : (r.margin > 0 ? "positive" : "");
        byId("metricBreakEven").textContent = money(r.breakEven);
        byId("metricMarkup").textContent = number2.format(r.markupMultiplier) + "x";
        byId("metricMarkupPercent").textContent = pct(r.markupPercent);
        byId("printDate").textContent = "Resumo gerado em " + new Date().toLocaleString("pt-BR");
        var status = byId("resultStatus");
        status.textContent = r.status;
        status.className = "result-status" + (r.status === "Prejuízo" ? " danger" : (r.status === "No ponto de equilíbrio" || r.status === "Margem positiva" ? " warning" : ""));
        renderDonut(r);
        byId("discountNote").textContent = r.discount > 0 ? "Desconto máximo estimado antes do prejuízo: " + pct(r.discount) : "Este preço não possui margem disponível para desconto.";
        byId("projectedRevenue").textContent = money(r.projectedRevenue);
        byId("projectedCost").textContent = money(r.projectedCost);
        byId("projectedFees").textContent = money(r.projectedFees);
        byId("projectedProfit").textContent = money(r.projectedProfit);
      }

      function renderDonut(r) {
        var valid = r.salePrice > 0 && r.cost >= 0 && r.feeValue >= 0 && r.profit >= 0;
        byId("compositionBlock").hidden = !valid;
        byId("invalidComposition").hidden = valid;
        if (!valid) return;
        var costPct = r.cost / r.salePrice * 100;
        var feePct = r.feeValue / r.salePrice * 100;
        var profitPct = Math.max(0, 100 - costPct - feePct);
        var costEnd = Math.min(100, costPct);
        var feeEnd = Math.min(100, costEnd + feePct);
        byId("donut").style.background = "conic-gradient(var(--silver) 0 " + costEnd + "%, #6F7B8A " + costEnd + "% " + feeEnd + "%, var(--emerald) " + feeEnd + "% 100%)";
        byId("legendCost").textContent = money(r.cost) + " · " + pct(costPct);
        byId("legendFees").textContent = money(r.feeValue) + " · " + pct(feePct);
        byId("legendProfit").textContent = money(r.profit) + " · " + pct(profitPct);
      }

      function renderBreakdown(input, r) {
        var rows = [
          ["Custo da peça", money(input.pieceCost)], ["Frete unitário", money(r.freightUnit)], ["Embalagem", money(input.packaging)],
          ["Outros custos", money(input.otherCosts)], ["Taxa fixa", money(input.fixedFee)], ["Custo unitário total", money(r.cost)],
          ["Taxas percentuais", pct(r.totalRatePercent)], ["Preço de equilíbrio", money(r.breakEven)], ["Lucro líquido", money(r.profit)], ["Margem real", pct(r.margin)]
        ];
        byId("breakdown").innerHTML = rows.map(function (row, i) { return "<div class='breakdown-row'><span class='index'>" + (i + 1) + "</span><dt>" + row[0] + "</dt><dd>" + row[1] + "</dd></div>"; }).join("");
      }

      function switchMode(nextMode) {
        mode = nextMode;
        document.querySelectorAll(".tab-button").forEach(function (tab) { tab.setAttribute("aria-selected", String(tab.dataset.mode === mode)); });
        document.querySelectorAll(".ideal-only").forEach(function (el) { el.hidden = mode !== "ideal"; });
        document.querySelectorAll(".analyze-only").forEach(function (el) { el.hidden = mode !== "analyze"; });
        byId("modeDescription").textContent = mode === "ideal" ? "Use esta opção quando você ainda não definiu o preço e deseja descobrir quanto precisa cobrar para alcançar determinada margem." : "Use esta opção quando você já tem um preço de venda e deseja descobrir o lucro líquido, a margem real, as taxas e o preço de equilíbrio.";
        byId("strategyDescription").textContent = mode === "ideal" ? "Defina a margem que você deseja preservar no preço." : "Informe o preço praticado e, se desejar, compare com sua meta de margem.";
        byId("mainPriceLabel").textContent = mode === "ideal" ? "Preço comercial sugerido" : "Preço de venda analisado";
        hasCalculated = false; lastResult = null; setError(""); hideResults();
      }

      function toggleFreight() {
        var isTotal = form.elements.freightMode.value === "total";
        byId("freightUnitFields").hidden = isTotal;
        byId("freightTotalFields").hidden = !isTotal;
        if (hasCalculated) calculate({ silent: true });
      }
      function updateTotalRate() {
        var ids = ["paymentRate", "marketplaceRate", "taxRate", "commissionRate", "discountReserve"];
        var sum = ids.reduce(function (total, id) { var n = fieldNumber(id); return total + (Number.isFinite(n) ? n : 0); }, 0);
        byId("totalRateDisplay").textContent = pct(sum);
      }
      function sanitizeInput(event) {
        var el = event.target;
        if (!el.matches("[data-money],[data-percent],[data-integer]")) return;
        el.value = el.value.replace(/-/g, "").replace(el.hasAttribute("data-integer") ? /[^0-9]/g : /[^0-9.,]/g, "");
      }
      function formatNumericInput(event) {
        var el = event.target;
        if (!el.matches("[data-money],[data-percent]")) return;
        if (!el.value.trim()) return;
        var n = safe(el.value);
        if (!Number.isFinite(n)) return;
        el.value = number2.format(n);
      }

      function clearForm() {
        form.reset();
        byId("desiredMargin").value = "40";
        byId("salesQuantity").value = "10";
        ["paymentRate", "marketplaceRate", "taxRate", "commissionRate", "discountReserve"].forEach(function (id) { byId(id).value = "0"; });
        byId("ratesDetails").open = false;
        toggleFreight(); updateTotalRate(); clearInvalid(); setError(""); lastResult = null; hasCalculated = false; hideResults(); byId("breakdown").innerHTML = ""; byId("pieceCost").focus();
      }
      function summaryText() {
        if (!lastResult) return "";
        var r = lastResult.result;
        var product = byId("pieceName").value.trim() || "Peça sem nome";
        var priceLabel = mode === "ideal" ? "Preço sugerido" : "Preço praticado";
        return "Produto: " + product + "\n\nCusto unitário: " + money(r.cost) + "\n" + priceLabel + ": " + money(r.salePrice) + "\nTaxas estimadas: " + money(r.feeValue) + "\nLucro líquido: " + money(r.profit) + "\nMargem real: " + pct(r.margin) + "\nPreço de equilíbrio: " + money(r.breakEven);
      }
      function copySummary() {
        var text = summaryText(); if (!text) return;
        if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text).then(function () { showToast("Resumo copiado com sucesso."); }).catch(function () { fallbackCopy(text); });
        else fallbackCopy(text);
      }
      function fallbackCopy(text) {
        var area = document.createElement("textarea"); area.value = text; area.style.position = "fixed"; area.style.opacity = "0"; document.body.appendChild(area); area.select();
        try { document.execCommand("copy"); showToast("Resumo copiado com sucesso."); } catch (e) { showToast("Não foi possível copiar automaticamente."); }
        area.remove();
      }

      function getHistory() {
        try { var value = JSON.parse(localStorage.getItem(storageKey) || "[]"); return Array.isArray(value) ? value : []; } catch (e) { return []; }
      }
      function setHistory(items) { try { localStorage.setItem(storageKey, JSON.stringify(items)); return true; } catch (e) { showToast("Não foi possível salvar no dispositivo."); return false; } }
      function captureFields() {
        var data = {};
        new FormData(form).forEach(function (value, key) { data[key] = value; });
        return data;
      }
      function saveCalculation() {
        if (!lastResult && !calculate({ focusError: true })) return;
        var history = getHistory();
        history.unshift({ id: Date.now().toString(36) + Math.random().toString(36).slice(2, 7), name: byId("pieceName").value.trim() || "Peça sem nome", category: byId("category").value || "Sem categoria", createdAt: new Date().toISOString(), mode: mode, fields: captureFields(), result: lastResult.result });
        if (setHistory(history)) { showToast("Cálculo salvo no seu dispositivo."); renderHistory(); }
      }
      function restoreRecord(record) {
        switchMode(record.mode === "analyze" ? "analyze" : "ideal");
        Object.keys(record.fields || {}).forEach(function (key) {
          var control = form.elements[key]; if (!control) return;
          if (control instanceof RadioNodeList) { Array.from(control).forEach(function (radio) { radio.checked = radio.value === record.fields[key]; }); }
          else control.value = record.fields[key];
        });
        toggleFreight(); updateTotalRate(); hasCalculated = true; calculate(); closeHistory(); byId("calculadora").scrollIntoView({ behavior: "smooth" }); showToast("Cálculo reaberto.");
      }
      function duplicateRecord(record) {
        var history = getHistory(); var copy = JSON.parse(JSON.stringify(record));
        copy.id = Date.now().toString(36) + Math.random().toString(36).slice(2, 7); copy.createdAt = new Date().toISOString(); copy.name = record.name + " (cópia)"; if (copy.fields) copy.fields.pieceName = copy.name;
        history.unshift(copy); if (setHistory(history)) { renderHistory(); showToast("Cálculo duplicado."); }
      }
      function deleteRecord(id) {
        if (!window.confirm("Deseja excluir este cálculo salvo?")) return;
        setHistory(getHistory().filter(function (item) { return item.id !== id; })); renderHistory(); showToast("Cálculo excluído.");
      }
      function renderHistory() {
        var history = getHistory(); var list = byId("historyList");
        if (!history.length) { list.innerHTML = "<div class='history-empty'>Você ainda não salvou nenhum cálculo.</div>"; return; }
        list.innerHTML = history.map(function (item) {
          var date = new Intl.DateTimeFormat("pt-BR", { dateStyle: "short", timeStyle: "short" }).format(new Date(item.createdAt));
          return "<article class='history-item' data-id='" + item.id + "'><div class='history-item-head'><div><h3>" + escapeHtml(item.name) + "</h3><small>" + escapeHtml(item.category) + " · " + date + "</small></div><small>" + (item.mode === "analyze" ? "Análise" : "Preço ideal") + "</small></div><div class='history-values'><div class='history-value'><span>Preço</span><strong>" + money(item.result.salePrice) + "</strong></div><div class='history-value'><span>Lucro</span><strong>" + money(item.result.profit) + "</strong></div><div class='history-value'><span>Margem</span><strong>" + pct(item.result.margin) + "</strong></div></div><div class='history-actions'><button class='mini-button' type='button' data-action='open'>Visualizar e reabrir</button><button class='mini-button' type='button' data-action='duplicate'>Duplicar</button><button class='mini-button delete' type='button' data-action='delete'>Excluir</button></div></article>";
        }).join("");
      }
      function escapeHtml(value) { return String(value).replace(/[&<>"']/g, function (char) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;" }[char]; }); }
      function exportHistoryCsv() {
        var history = getHistory(); if (!history.length) { showToast("Não há cálculos para exportar."); return; }
        var rows = [["Data", "Nome da peça", "Categoria", "Modo", "Custo unitário", "Preço", "Taxas", "Lucro", "Margem"]];
        history.forEach(function (item) { rows.push([new Date(item.createdAt).toLocaleString("pt-BR"), item.name, item.category, item.mode === "analyze" ? "Analisar preço" : "Preço ideal", number2.format(item.result.cost), number2.format(item.result.salePrice), number2.format(item.result.feeValue), number2.format(item.result.profit), number2.format(item.result.margin) + "%"]); });
        var csv = "\uFEFF" + rows.map(function (row) { return row.map(function (cell) { return '"' + String(cell).replace(/"/g, '""') + '"'; }).join(";"); }).join("\r\n");
        var url = URL.createObjectURL(new Blob([csv], { type: "text/csv;charset=utf-8" })); var a = document.createElement("a"); a.href = url; a.download = "historico-calculadora-da-prata.csv"; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url); showToast("Histórico exportado em CSV.");
      }
      function openHistory() { renderHistory(); byId("historyDrawer").classList.add("is-open"); byId("drawerBackdrop").classList.add("is-open"); byId("historyDrawer").setAttribute("aria-hidden", "false"); byId("openHistory").setAttribute("aria-expanded", "true"); document.body.style.overflow = "hidden"; byId("closeHistory").focus(); }
      function closeHistory() { byId("historyDrawer").classList.remove("is-open"); byId("drawerBackdrop").classList.remove("is-open"); byId("historyDrawer").setAttribute("aria-hidden", "true"); byId("openHistory").setAttribute("aria-expanded", "false"); document.body.style.overflow = ""; byId("openHistory").focus(); }

      form.addEventListener("submit", function (event) { event.preventDefault(); calculate({ focusError: true }); });
      form.addEventListener("input", function (event) { sanitizeInput(event); updateTotalRate(); if (hasCalculated) calculate({ silent: true }); });
      form.addEventListener("blur", formatNumericInput, true);
      form.addEventListener("change", function () { if (hasCalculated) calculate({ silent: true }); });
      document.querySelectorAll("input[name='freightMode']").forEach(function (radio) { radio.addEventListener("change", toggleFreight); });
      document.querySelectorAll(".tab-button").forEach(function (button) { button.addEventListener("click", function () { switchMode(button.dataset.mode); }); });
      document.querySelectorAll(".preset").forEach(function (button) { button.addEventListener("click", function () { byId("desiredMargin").value = button.dataset.margin; if (hasCalculated) calculate({ silent: true }); }); });
      byId("clearButton").addEventListener("click", clearForm);
      byId("saveButton").addEventListener("click", saveCalculation);
      byId("copyButton").addEventListener("click", copySummary);
      byId("printButton").addEventListener("click", function () { window.print(); });
      byId("openHistory").addEventListener("click", openHistory);
      byId("closeHistory").addEventListener("click", closeHistory);
      byId("drawerBackdrop").addEventListener("click", closeHistory);
      byId("exportCsv").addEventListener("click", exportHistoryCsv);
      byId("clearHistory").addEventListener("click", function () { var history = getHistory(); if (!history.length) { showToast("O histórico já está vazio."); return; } if (window.confirm("Deseja apagar todo o histórico? Esta ação não poderá ser desfeita.")) { setHistory([]); renderHistory(); showToast("Histórico apagado."); } });
      byId("historyList").addEventListener("click", function (event) { var button = event.target.closest("[data-action]"); if (!button) return; var item = getHistory().find(function (record) { return record.id === button.closest("[data-id]").dataset.id; }); if (!item) return; if (button.dataset.action === "open") restoreRecord(item); if (button.dataset.action === "duplicate") duplicateRecord(item); if (button.dataset.action === "delete") deleteRecord(item.id); });
      document.addEventListener("keydown", function (event) { if (event.key === "Escape" && byId("historyDrawer").classList.contains("is-open")) closeHistory(); });
      updateTotalRate(); hideResults(); renderHistory();
    })();
  </script>
